        <mxCell id="r_imu" value="IMU timer /heartbeat&lt;br/&gt;&lt;font style='font-size:9px'&gt;PUB_PERIOD 1000 ms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" parent="b3" vertex="1">

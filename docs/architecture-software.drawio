        </mxCell>
        <mxCell id="r_s0" value="W5500 socket 0" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" parent="b3" vertex="1">
          <mxGeometry as="geometry" x="960" y="45" width="160" height="80" />
        </mxCell>
        <mxCell id="r_udp" value="UDP :5000 -&amp;gt; agent :8888" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" parent="b3" vertex="1">
          <mxGeometry as="geometry" x="1160" y="45" width="180" height="80" />
        </mxCell>
        <mxCell id="r_agent" value="micro-ROS agent&lt;br/&gt;&lt;font style='font-size:9px'&gt;/heartbeat, /imu/data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="b3" vertex="1">
          <mxGeometry as="geometry" x="1360" y="45" width="150" height="80" />
        </mxCell>
        <mxCell id="q1" value="1. sensor clocks&lt;br/&gt;PCLK bytes; DCMI&lt;br/&gt;packs words, requests DMA" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" parent="b4" vertex="1">
          <mxGeometry as="geometry" x="20" y="50" width="175" height="70" />
        </mxCell>
        <mxCell id="q2" value="2. DMA fills slot&lt;br/&gt;M0AR + NDTR" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" parent="b4" vertex="1">
          <mxGeometry as="geometry" x="225" y="50" width="155" height="70" />
        </mxCell>
        <mxCell id="q3" value="3. VSYNC edge at&lt;br/&gt;frame end: DCMI sets&lt;br/&gt;RIS.FRAME, IRQ to nvic@78" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" parent="b4" vertex="1">
          <mxGeometry as="geometry" x="410" y="50" width="165" height="70" />
        </mxCell>
        <mxCell id="q4" value="4. DCMI_IRQHandler:&lt;br/&gt;publish slot, advance&lt;br/&gt;write_slot, re-arm DMA" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" parent="b4" vertex="1">
          <mxGeometry as="geometry" x="605" y="50" width="170" height="70" />
        </mxCell>
        <mxCell id="q5" value="5. DCMI stops capture&lt;br/&gt;(snapshot CM) until&lt;br/&gt;next frame start" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" parent="b4" vertex="1">
          <mxGeometry as="geometry" x="805" y="50" width="155" height="70" />
        </mxCell>
        <mxCell id="q6" value="6. take_frame(): strip&lt;br/&gt;Y in place, set pointer&lt;br/&gt;(main loop, not ISR)" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" parent="b4" vertex="1">
          <mxGeometry as="geometry" x="990" y="50" width="170" height="70" />
        </mxCell>
        <mxCell id="q7" value="7. video_udp_step()&lt;br/&gt;copies ROWS_PER_DGRAM&lt;br/&gt;rows + 20 B header" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" parent="b4" vertex="1">
          <mxGeometry as="geometry" x="1190" y="50" width="160" height="70" />
        </mxCell>
        <mxCell id="q8" value="8. sendto() per block;&lt;br/&gt;deadline pacer to VIDEO_FPS" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" parent="b4" vertex="1">
          <mxGeometry as="geometry" x="1380" y="50" width="130" height="70" />
        </mxCell>
        <mxCell id="q9" value="Invariant that keeps it aligned:&lt;br/&gt;a frame slot is re-armed &lt;b&gt;at the frame boundary&lt;/b&gt;.&lt;br/&gt;QVGA luma-only / QQVGA &amp;#8594; slot == one sensor frame &amp;#8594; self-aligning (verified).&lt;br/&gt;Any &lt;b&gt;crop&lt;/b&gt; &amp;#8594; slot &amp;lt; sensor frame &amp;#8594; software re-arm must hit the boundary exactly (unreliable in Renode)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=8;spacingTop=6;" parent="b4" vertex="1">
          <mxGeometry as="geometry" x="20" y="150" width="760" height="90" />
        </mxCell>
        <mxCell id="q10" value="Timing budget @ 320x240, VIDEO_FPS=24:&lt;br/&gt;period 41.7 ms &amp;#183; SPI 22.5 MHz (/4) &amp;#8594; ~29 ms of 81.4 KB SPI traffic&lt;br/&gt;pacer = 1000/VIDEO_FPS ms deadline, overruns drop debt instead of cascading&lt;br/&gt;measured 24.00 fps emulated; host-observed ~0.1 fps is Renode throughput, not firmware&lt;br/&gt;host-observed rate &amp;#8800; emulated rate &amp;#8212; always report the emulated one." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=8;spacingTop=6;" parent="b4" vertex="1">
          <mxGeometry as="geometry" x="810" y="150" width="700" height="90" />
        </mxCell>
        <mxCell id="q11" value="Buffer arithmetic (why QVGA YUV422 is impossible):&lt;br/&gt;YUV422 = 2 byte/pixel &amp;#8594; 320x240 = 153,600 B &amp;gt; 128 KB RAM (fails at link: &lt;i&gt;region RAM overflowed&lt;/i&gt;)&lt;br/&gt;luma-only via DCMI byte select = 1 byte/pixel &amp;#8594; 76,800 B &amp;#8594; fits&lt;br/&gt;QQVGA 160x120 YUV422 = 38,400 B/frame &amp;#8594; 2-frame ring = 76,800 B &amp;#8594; verified&lt;br/&gt;OV7670 has no YUV420; F4 DCMI has no CGR/CCMR &amp;#8594; chroma must be stripped on the CPU." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=8;spacingTop=6;" parent="b4" vertex="1">
          <mxGeometry as="geometry" x="20" y="265" width="1490" height="105" />
        </mxCell>

        </mxCell>
        <mxCell id="r_xrce" value="w5500_transport.c&lt;br/&gt;&lt;font style='font-size:9px'&gt;XRCE datagrams, MTU 1472&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" parent="b3" vertex="1">

          <mxGeometry as="geometry" x="250" y="45" width="210" height="80" />
        </mxCell>
        <mxCell id="r_ros" value="libmicroros&lt;br/&gt;&lt;font style='font-size:9px'&gt;pool 40 KB static RMW&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" parent="b3" vertex="1">

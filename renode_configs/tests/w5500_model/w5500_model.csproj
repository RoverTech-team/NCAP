<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RenodeInfra Condition="'$(RenodeInfra)' == ''">/Applications/renode/output/bin/Release/Infrastructure.dll</RenodeInfra>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../peripherals/W5500.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="EthernetTests.cs" />
    <Reference Include="Infrastructure">
      <HintPath>$(RenodeInfra)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
